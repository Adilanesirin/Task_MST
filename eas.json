{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_POST_INSTALL_COMMAND": "node ./eas-hooks/eas-build-post-install.js"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_BUILD_POST_INSTALL_COMMAND": "node ./eas-hooks/eas-build-post-install.js"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EAS_BUILD_POST_INSTALL_COMMAND": "node ./eas-hooks/eas-build-post-install.js"
      }
    }
  },
  "submit": {
    "production": {}
  }
}